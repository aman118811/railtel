# Copy to .env and fill in. .env is git-ignored.

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string and replace <password> with your real password (without the < > brackets).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cctv

# API port, and the browser origin(s) allowed to call it (comma separated; * = any).
PORT=4000
CORS_ORIGIN=*
