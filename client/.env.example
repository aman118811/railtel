# Optional. By default the app calls the API at /api on its own origin (Vite proxies it to localhost:4000 in development).
# Only set this if the API is hosted on a different address, e.g. https://api.example.com/api
# VITE_API_URL=
#
# Never put MONGODB_URI or any database credential in the client: anything starting with VITE_ is public in the browser.
